# Stripe LIVE keys — set these in Vercel / local env. Do not commit real values.
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key

# App
PORT=3001
HOST=127.0.0.1
CLIENT_URL=http://localhost:5173

# Local sqlite fallback (used when DATABASE_URL is unset)
DATABASE_PATH=./orders.db

# Isolated payment-to-asset store (HTTP gateway / Cloudflare tunnel)
# DATABASE_URL=https://your-tunnel.trycloudflare.com
# DATABASE_TOKEN=dedicated-p2a-token

# Mainnet payouts — required per chain that you want to send.
# ETH: 32-byte hex private key
HOT_WALLET_PRIVATE_KEY=
# Optional override for ETH only
# ETH_HOT_WALLET_PRIVATE_KEY=

# SOL: base58 secret, 64-byte hex, JSON byte array, or 32-byte hex seed
SOL_HOT_WALLET_SECRET=

# BTC: Bitcoin mainnet WIF
BTC_HOT_WALLET_WIF=

# Optional RPC / API overrides (public defaults are used when unset)
# ETH_RPC_URL=https://cloudflare-eth.com
# SOL_RPC_URL=https://api.mainnet-beta.solana.com
# BTC_API_URL=https://mempool.space/api

# Optional explicit swap deposit addresses (shown to the user; do not invent them)
# If unset, public addresses are derived from the hot-wallet keys above when possible.
# SWAP_DEPOSIT_SOL=
# SWAP_DEPOSIT_ETH=
# SWAP_DEPOSIT_BTC=

# Isolated swap deposit PUBLIC addresses (Vercel). Private keys stay on onetwo.
# SWAP_DEPOSIT_SOL=
# SWAP_DEPOSIT_ETH=
# SWAP_DEPOSIT_BTC=
# SWAP_DATA_DIR=/home/vboxuser/apps/payment-to-asset/data/wallets
# SWAP_PAYOUT_ON_API=0
